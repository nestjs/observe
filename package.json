{
  "name": "@nestjs/observe",
  "version": "0.3.1",
  "description": "Observability and APM agent for NestJS - traces, runtime metrics, custom metrics and CPU profiles",
  "author": "Kamil Mysliwiec",
  "homepage": "https://observe.nestjs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestjs/observe.git"
  },
  "bugs": {
    "url": "https://github.com/nestjs/observe/issues"
  },
  "keywords": [
    "nestjs",
    "nest",
    "observability",
    "apm",
    "tracing",
    "telemetry",
    "metrics",
    "profiling",
    "instrumentation",
    "monitoring",
    "opentelemetry",
    "distributed-tracing",
    "error-tracking",
    "logging",
    "performance"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "build:into": "tsc -p tsconfig.build.json --watch --preserveWatchOutput --outDir",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "oxlint --type-aware src",
    "lint:fix": "oxlint --type-aware --fix src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts",
    "prepack": "npm run build",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prerelease": "npm run build",
    "release": "release-it",
    "prepare": "husky"
  },
  "license": "MIT",
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31"
  },
  "peerDependencies": {
    "@nestjs/bull": "^11.0.0 || ^12.0.0",
    "@nestjs/bullmq": "^11.0.0 || ^12.0.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@nestjs/graphql": "^13.0.0 || ^14.0.0",
    "@nestjs/microservices": "^11.0.0 || ^12.0.0",
    "@nestjs/schedule": "^4.0.0 || ^5.0.0 || ^6.0.0 || ^12.0.0",
    "@nestjs/websockets": "^11.0.0 || ^12.0.0",
    "bull": "^3.3.0 || ^4.0.0",
    "bullmq": "^5.0.0 || ^6.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/bull": {
      "optional": true
    },
    "@nestjs/bullmq": {
      "optional": true
    },
    "@nestjs/graphql": {
      "optional": true
    },
    "@nestjs/microservices": {
      "optional": true
    },
    "@nestjs/schedule": {
      "optional": true
    },
    "@nestjs/websockets": {
      "optional": true
    },
    "bull": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-angular": "21.2.2",
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@mikro-orm/core": "7.2.0",
    "@mikro-orm/mysql": "7.2.0",
    "@mikro-orm/postgresql": "7.2.0",
    "@nestjs/apollo": "14.0.0",
    "@nestjs/bull": "12.0.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/graphql": "14.0.0",
    "@nestjs/microservices": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/platform-fastify": "12.0.3",
    "@nestjs/platform-socket.io": "12.0.3",
    "@nestjs/platform-ws": "12.0.3",
    "@nestjs/schedule": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@nestjs/websockets": "12.0.3",
    "@swc/core": "1.16.1",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.11",
    "bull": "4.16.5",
    "bullmq": "6.2.0",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "graphql": "16.14.2",
    "husky": "9.1.7",
    "ioredis": "6.0.0",
    "lint-staged": "17.3.0",
    "mongodb": "7.6.0",
    "mongoose": "9.10.1",
    "mysql2": "3.24.4",
    "nestjs-cls": "6.2.1",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "pg": "8.23.0",
    "prettier": "3.2.5",
    "reflect-metadata": "0.2.2",
    "release-it": "21.0.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2",
    "typeorm": "1.1.1",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  },
  "overrides": {
    "nestjs-cls": {
      "@nestjs/common": "$@nestjs/common",
      "@nestjs/core": "$@nestjs/core"
    }
  },
  "lint-staged": {
    "**/*.{ts,json}": []
  },
  "type": "module"
}
